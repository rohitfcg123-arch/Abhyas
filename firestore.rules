rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/playlistVideos/{videoId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validVideo(data) {
        return data.keys().hasAll(['title', 'url', 'videoId', 'createdAt'])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.url is string
          && data.url.size() <= 2048
          && data.videoId is string
          && data.videoId.matches('^[A-Za-z0-9_-]{11}$');
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validVideo(request.resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}