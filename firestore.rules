rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validProfile(data) {
        return data.keys().hasAll(['uid', 'name', 'email'])
          && data.uid == userId
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 80
          && data.email is string
          && data.email.size() <= 254;
      }
      allow read: if isOwner();
      allow create, update: if isOwner() && validProfile(request.resource.data);
      allow delete: if false;
    }
    match /users/{userId}/playlistVideos/{videoId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validVideo(data) {
        return data.keys().hasAll(['title', 'url', 'videoId', 'createdAt'])
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.url is string
          && data.url.size() <= 2048
          && data.videoId is string
          && data.videoId.matches('^[A-Za-z0-9_-]{11}$');
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validVideo(request.resource.data);
    }
    match /users/{userId}/youtubeChannels/{channelDocId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validChannel(data) {
        return data.keys().hasAll(['channelId', 'title', 'thumbnail', 'createdAt'])
          && data.channelId is string
          && data.channelId == channelDocId
          && data.title is string
          && data.title.size() > 0
          && data.title.size() <= 180
          && data.thumbnail is string
          && data.thumbnail.size() <= 2048
          && data.createdAt is timestamp;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validChannel(request.resource.data);
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}